# Copia este archivo a ".env" (en esta misma carpeta) y cambia el PIN. El archivo .env no se sube a git.

# PIN del aula del profesor: mínimo 6 caracteres. Por defecto es 12345678, que conoce cualquiera que tenga este programa:
# vale para pruebas; cámbialo antes de usarlo con una clase real.
AULA_PIN=12345678

# Puertos en los que nginx publica el aula; los dos van por HTTPS (certificado propio, ver nginx/generar_certificado.sh)
AULA_PUERTO_HTTP=80
AULA_PUERTO_HTTPS=447

# Módulos que se sugieren al registrarse, separados por comas (opcional; el alumno puede escribir otro)
AULA_MODULOS=

# Con nginx delante todo va por HTTPS: la cookie de sesión solo viaja por HTTPS (déjalo en 1)
AULA_COOKIE_SEGURA=1

# Minutos que dura la sesión del profesor tras poner el PIN
AULA_SESION_PROFESOR_MIN=120

# Intentos fallidos (contraseña o PIN) antes de bloquear, y segundos de bloqueo
AULA_MAX_INTENTOS=5
AULA_BLOQUEO_S=300
